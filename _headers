# HTML은 항상 최신을 받게 (배포 후 옛 화면이 남는 문제 방지)
/*.html
  Cache-Control: no-cache, must-revalidate

/songsan/escape/
  Cache-Control: no-cache, must-revalidate

# 이미지·정적 자산은 캐시해도 됨
/songsan/escape/assets/*
  Cache-Control: public, max-age=86400

# 링크인바이오 — 인앱 브라우저(인스타 등)가 옛 버전을 물고 있지 않게 항상 최신
/link/
  Cache-Control: no-store
/link/*
  Cache-Control: no-store
/iabtest/*
  Cache-Control: no-store
/shuung
  Cache-Control: no-store
/pray
  Cache-Control: no-store
/poly
  Cache-Control: no-store
/neoix
  Cache-Control: no-store
